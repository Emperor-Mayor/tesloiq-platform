# Remove .html extension from URLs
<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Don't rewrite if the request is for a real file or folder
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  
  # Rewrite requests to .html files without showing the extension
  RewriteRule ^([^\.]+)$ $1.html [NC,L]
</IfModule>
